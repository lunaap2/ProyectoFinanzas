rules_version = '2';

// Reglas de referencia para Firebase Storage. Pegar en:
// Firebase Console > Storage > Reglas > Publicar.
service firebase.storage {
  match /b/{bucket}/o {

    // Evidencias fotograficas: cualquier usuario autenticado puede leer (para que las
    // fotos se vean en todos los dispositivos); cada usuario solo puede escribir dentro
    // de su propia carpeta "evidencias/{su_uid}/...".
    match /evidencias/{uid}/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
